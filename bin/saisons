#!/usr/bin/perl
use strict;
use warnings;
use utf8;
use open qw(:utf8);
binmode STDOUT, ':utf8';
binmode STDERR, ':utf8';
# Windows has no HOME; normalize once so every "$ENV{HOME}/..." below works
BEGIN { $ENV{HOME} //= $ENV{USERPROFILE} // '' }
use lib "$ENV{HOME}/.local/lib";
use lib 'lib';
use Module::Pluggable (
    search_path => 'App::Saisons::Adapter',
    require     => 1,
    inner       => 0,
);
use App::Saisons;
use App::Saisons::UI;
use App::Saisons::Launcher ();
use App::Saisons::Transfer ();
use Getopt::Long ();

my %opt;
Getopt::Long::GetOptions(\%opt, 'version', 'export:s', 'import=s', 'clone!', 'dry-run')
    or die "Usage: saisons [--export [FILE]] [--import FILE [--clone|--no-clone] [--dry-run]] [--version]\n";

if ($opt{version}) {
    print 'saisons ' . App::Saisons::version_string() . "\n";
    exit 0;
}

# ── load sessions from all adapters ──────────────────────────────────────────
# To add a new agent: see lib/Saisons/Adapter/HOWTO.md

my @adapters = map { $_->new }
               grep { $_->can('find_sessions') }
               plugins();

sub load_sessions {
    my (@sessions, %running);
    for my $adapter (@adapters) {
        push @sessions, $adapter->find_sessions;
        %running = (%running, $adapter->running);
    }
    @sessions = sort { $b->{date} cmp $a->{date} } @sessions;
    App::Saisons::UI::annotate_running(\@sessions, \%running);
    return (\@sessions, \%running);
}

# ── export / import ──────────────────────────────────────────────────────────

if (exists $opt{export}) {
    my ($sessions) = load_sessions();
    die "No sessions found.\n" unless @$sessions;
    my $file = length $opt{export} ? $opt{export} : App::Saisons::Transfer::default_file();
    my $r = App::Saisons::Transfer::export_sessions($sessions, $file);
    print map { "$_\n" } App::Saisons::Transfer::export_summary($r);
    exit 0;
}
if (defined $opt{import}) {
    my @results = App::Saisons::Transfer::import_bundle($opt{import}, \@adapters,
        clone => $opt{clone}, dry_run => $opt{'dry-run'});
    exit((grep { $_->{status} eq 'error' } @results) ? 1 : 0);
}

# ── detect launcher ───────────────────────────────────────────────────────────

my $launcher = $ENV{SAISONS_LAUNCHER} // $ENV{CLAUDE_SESSIONS_LAUNCHER} // do {
    if    ($ENV{TMUX})                                          { 'tmux' }
    elsif ($ENV{STY})                                           { 'screen' }
    elsif ($ENV{TILIX_ID}
           && `which tilix 2>/dev/null` =~ /\S/)               { 'tilix' }
    elsif ($ENV{PTYXIS_VERSION}
           && `which ptyxis 2>/dev/null` =~ /\S/)              { 'ptyxis' }
    elsif (($ENV{DISPLAY} || $ENV{WAYLAND_DISPLAY})
           && `which gnome-terminal 2>/dev/null` =~ /\S/)      { 'gnome-terminal' }
    elsif (($ENV{TERM_PROGRAM} // '') eq 'iTerm.app')          { 'iterm' }
    elsif ($^O eq 'darwin')                                     { 'terminal-app' }
    else                                                        { 'inline' }
};

# ── UI loop — keep running until user quits ───────────────────────────────────

my $ui = App::Saisons::UI->new;

while (1) {
    my ($sessions, $running) = load_sessions();
    die "No sessions found.\n" unless @$sessions;

    my @selected = $ui->interactive_select($sessions, $running, \&load_sessions);

    # Empty selection means the user pressed q/ESC — exit
    last unless @selected;

    # Launch selected sessions then loop back to the list
    my %by_adapter;
    for my $s (@selected) {
        push @{ $by_adapter{ ref $s->{_adapter} } }, $s;
    }
    App::Saisons::Launcher::batch($launcher, sub {
        for my $group (values %by_adapter) {
            $group->[0]{_adapter}->launch($group, $launcher);
        }
    });
}

__END__

=head1 NAME

saisons - browse and resume AI coding agent sessions from one list

=head1 SYNOPSIS

    saisons
    saisons --export [FILE]
    saisons --import FILE [--clone | --no-clone] [--dry-run]
    saisons --version

=head1 DESCRIPTION

saisons lists the coding agent sessions it finds on the machine - Claude
Code, OpenAI Codex, Gemini CLI, Aider and opencode - in one terminal UI.
The list shows each session's agent, age, size, path and title, and can be
filtered, searched full-text, grouped and sorted.

Running sessions get a bullet: yellow while the agent is working (its
transcript was written in the last few seconds), green when it sits at the
prompt waiting for input.

Pressing ENTER resumes the selected sessions by running each agent's
resume command in the session's directory: in a new tmux or screen window,
a new terminal tab, or inline in the current terminal, depending on the
environment.

=head1 KEYS

    Up/Down, j/k     move            /        filter (title, path, date)
    PgUp/PgDn        page            ?        full-text search
    Home/End, g/G    top / bottom    Alt+C    toggle case sensitivity
    Space            toggle select   s        sort mode (arrows pick)
    a / A            select all/none S        flip sort direction
    ENTER            open selected   t        cycle grouping
    v                view history    r        refresh running markers
    d                delete          m        move to other directory
    e                export to a file
    q / ESC          quit

With a filter or search active, ENTER, delete and move act only on the
selected sessions it shows. Export takes the marked sessions, or all shown
ones if none are marked.

=head1 MOVING SESSIONS TO ANOTHER MACHINE

C<--export> writes every session to one C<.tar.gz> file, named after the
host and date unless you give a name. Copy the file over and run
C<--import> there.

Import adds the sessions next to the ones already there and skips any
that are already there. Paths under the old home directory are changed to
the new one.

Before importing, it reports each project folder the sessions use: there,
missing with the C<git clone> command to get it back, missing and not in
git, or a repo that lacks the commit the source was on. It warns about
uncommitted and unpushed work on the source. It then offers to clone the
missing repos; C<--clone> and C<--no-clone> answer for you. C<--dry-run>
shows the report and imports nothing.

Aider sessions live in the project folder and are skipped until it
exists; import again once it does. Logins and API keys are not exported.

=head1 ENVIRONMENT

=over 4

=item SAISONS_LAUNCHER

Where selected sessions open: C<tmux>, C<screen>, C<ptyxis>,
C<tilix>, C<gnome-terminal>, C<iterm>, C<terminal-app> or C<inline>. Without it,
saisons picks one from the environment. The old name
C<CLAUDE_SESSIONS_LAUNCHER> still works.

=item SAISONS_SEARCH_DIRS

Directories to scan for Aider history files, separated like C<PATH>
(C<:>, or C<;> on Windows), instead of
the default project directories.

=back

